            {
              "id": "rcb-advantage-list",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<ul style=\"margin: 0; padding-left: 20px; color: #37474f;\"><li style=\"margin-bottom: 10px;\"><strong>Seamless Integration:</strong> Connect your WooCommerce store to Carrybee in minutes with our easy setup wizard.</li><li style=\"margin-bottom: 10px;\"><strong>Automated Workflow:</strong> Orders are automatically synced with Carrybee, reducing manual data entry and errors.</li><li style=\"margin-bottom: 10px;\"><strong>Complete Visibility:</strong> Track all shipments from creation to delivery with real-time status updates.</li><li style=\"margin-bottom: 10px;\"><strong>Flexible Configuration:</strong> Configure shipping rates, zones, and delivery options to match your business needs.</li><li style=\"margin-bottom: 10px;\"><strong>100% Free & Open Source:</strong> No premium upsells, no feature locks. Full functionality available for everyone.</li><li style=\"margin-bottom: 0;\"><strong>Developer Friendly:</strong> Clean code, proper hooks, and filters for easy customization.</li></ul>"
              }
            }
          ]
