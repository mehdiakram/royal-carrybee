              "bottom": "0",
              "left": "5"
            },
            "border_color": "#FF6B35",
            "margin": {
              "unit": "px",
              "bottom": "25"
            }
          },
          "elements": [
            {
              "id": "rcb-features-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "🚀 Powerful Features at Your Fingertips",
                "title_color": "#FF6B35",
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "em",
                  "size": 1.3
                }
              }
            },
            {
              "id": "rcb-features-list",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style=\"color: #555; margin-bottom: 15px;\">Royal Carrybee comes with everything you need for efficient shipping management:</p><div style=\"display: grid; gap: 12px;\"><div style=\"background: #fff; padding: 15px; border-radius: 8px; border-left: 4px solid #FF6B35;\"><strong style=\"color: #FF6B35;\">🔗 Carrybee API v2.0 Integration:</strong> <span style=\"color: #555;\">Full integration with Carrybee's latest API for reliable order management and tracking.</span></div><div style=\"background: #fff; padding: 15px; border-radius: 8px; border-left: 4px solid #27ae60;\"><strong style=\"color: #27ae60;\">📍 Cascading Location Dropdowns:</strong> <span style=\"color: #555;\">Smart City → Zone → Area selection at checkout for accurate delivery addresses.</span></div><div style=\"background: #fff; padding: 15px; border-radius: 8px; border-left: 4px solid #9b59b6;\"><strong style=\"color: #9b59b6;\">🏪 Store Management:</strong> <span style=\"color: #555;\">Manage multiple pickup stores directly from your WordPress dashboard.</span></div><div style=\"background: #fff; padding: 15px; border-radius: 8px; border-left: 4px solid #e74c3c;\"><strong style=\"color: #e74c3c;\">📦 One-Click Order Creation:</strong> <span style=\"color: #555;\">Create Carrybee shipping orders directly from WooCommerce order pages with a single click.</span></div><div style=\"background: #fff; padding: 15px; border-radius: 8px; border-left: 4px solid #f39c12;\"><strong style=\"color: #f39c12;\">🔄 Webhook Support:</strong> <span style=\"color: #555;\">Real-time order status updates via Carrybee webhooks for instant tracking information.</span></div><div style=\"background: #fff; padding: 15px; border-radius: 8px; border-left: 4px solid #1abc9c;\"><strong style=\"color: #1abc9c;\">🎨 Beautiful Admin Interface:</strong> <span style=\"color: #555;\">Modern, intuitive dashboard with SweetAlert2 notifications and DataTables integration.</span></div><div style=\"background: #fff; padding: 15px; border-radius: 8px; border-left: 4px solid #34495e;\"><strong style=\"color: #34495e;\">🧪 Sandbox & Production Modes:</strong> <span style=\"color: #555;\">Test your integration safely in sandbox mode before going live with production.</span></div><div style=\"background: #fff; padding: 15px; border-radius: 8px; border-left: 4px solid #e67e22;\"><strong style=\"color: #e67e22;\">🌐 Multilingual Ready:</strong> <span style=\"color: #555;\">Full translation support with Bengali (বাংলা) included out of the box.</span></div></div>"
              }
            }
          ]
