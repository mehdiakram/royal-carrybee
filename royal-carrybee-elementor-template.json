            {
              "id": "rcb-shipping-text",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style=\"color: #5D4037; margin-bottom: 15px;\">Everything you need for hassle-free shipping:</p><div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;\"><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #FF6B35;\">📋 Order Management</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">View & manage all orders</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #F7931E;\">🔍 Real-Time Tracking</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">Live shipment updates</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #FF9800;\">📊 Order Analytics</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">Track delivery performance</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #EF6C00;\">💰 COD Support</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">Cash on delivery ready</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #E65100;\">📍 Area Coverage</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">Nationwide delivery</p></div><div style=\"background: rgba(255,255,255,0.9); padding: 15px; border-radius: 8px; text-align: center;\"><strong style=\"color: #BF360C;\">⚡ Fast Processing</strong><p style=\"margin: 5px 0 0; color: #666; font-size: 14px;\">Quick order handover</p></div></div>"
              }
            }
