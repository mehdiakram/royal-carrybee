              "unit": "px",
              "bottom": "25"
            }
          },
          "elements": [
            {
              "id": "rcb-intro-text",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style=\"color: #333; margin-bottom: 1.5em; font-size: 16px;\"><strong>Why Choose Royal Carrybee?</strong> Managing shipping in Bangladesh can be complex and time-consuming. <strong>Royal Carrybee</strong> integrates your WooCommerce store directly with Carrybee courier service, enabling <strong>automated order creation, real-time tracking, and seamless delivery management</strong>.</p>"
              }
            }
          ]
        },
        {
